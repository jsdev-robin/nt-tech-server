{
  "name": "@server/monolithic",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/monolithic/dist",
          "format": [
            "cjs"
          ],
          "bundle": false,
          "main": "apps/monolithic/src/main.ts",
          "tsConfig": "apps/monolithic/tsconfig.app.json",
          "assets": [
            "apps/monolithic/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "generateLockfile": true,
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/monolithic/dist/package.json",
          "{workspaceRoot}/apps/monolithic/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/monolithic/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/monolithic/dist/patches",
          "{workspaceRoot}/apps/monolithic/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/monolithic/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@server/monolithic:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@server/monolithic:build:development"
          },
          "production": {
            "buildTarget": "@server/monolithic:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune"
        ]
      }
    }
  },
  "dependencies": {
    "@server/constants": "workspace:*",
    "@server/protect": "workspace:*",
    "@server/types": "workspace:*",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@simplewebauthn/server": "^14.0.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "@upstash/redis": "^1.39.0",
    "backup-key": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "bullmq": "^6.3.16",
    "cloudinary": "^2.11.0",
    "connect-redis": "^10.0.0",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.6.0",
    "device-uuid": "^3.0.6",
    "dotenv": "^18.0.8",
    "ejs": "^7.0.1",
    "express": "^5.1.0",
    "express-global-guard": "^2.0.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "express-useragent": "^2.2.3",
    "express-zod-guard": "^3.0.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "http-status-codes": "^2.3.0",
    "ioredis": "^6.0.0",
    "ipinfo-express": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "mongoose-query-find": "^4.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "node-encryptor": "^1.1.0",
    "node-ipinfo": "^4.4.0",
    "nodemailer": "^10.1.2",
    "otplib": "^13.5.0",
    "p-retry": "^8.0.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode": "^1.5.4",
    "redis": "^6.3.0",
    "simple-statistics": "^7.12.1",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.4",
    "speakeasy": "^2.0.0",
    "validator": "^13.15.35",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express-session": "^1.19.0",
    "@types/http-errors": "^2.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/validator": "^13.15.10",
    "@types/web-push": "^3.6.4"
  }
}
