{
  "name": "@server/monolithic-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@server/monolithic"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "@server/monolithic:build",
          "@server/monolithic:serve"
        ],
        "options": {
          "jestConfig": "apps/monolithic-e2e/jest.config.cts",
          "passWithNoTests": true
        }
      }
    }
  }
}
